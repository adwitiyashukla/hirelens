HIRELENS_LLM_PROVIDER=gemini

HIRELENS_GEMINI_API_KEY=
HIRELENS_GEMINI_MODEL=gemini-flash-latest

HIRELENS_GROQ_API_KEY=
HIRELENS_GROQ_MODEL=llama-3.3-70b-versatile

HIRELENS_OLLAMA_HOST=http://localhost:11434
HIRELENS_OLLAMA_MODEL=qwen3:4b

HIRELENS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

HIRELENS_EXTRACTION_TEMPERATURE=0.0
HIRELENS_JUDGE_TEMPERATURE=0.3
HIRELENS_SELF_CONSISTENCY_K=3

HIRELENS_REQUESTS_PER_MINUTE=15

HIRELENS_TOKENS_PER_MINUTE=0

HIRELENS_MAX_CONCURRENT_REQUESTS=2

HIRELENS_CACHE_ENABLED=true
HIRELENS_CACHE_DIR=.hirelens_cache

HIRELENS_BLIND_MODE=true

HIRELENS_MAX_DEMOGRAPHIC_DRIFT=2.0

HIRELENS_GITHUB_TOKEN=

HIRELENS_LOG_LEVEL=INFO
