# ---------------------------------------------------------------------------
# HireLens configuration
#
# You do not need to fill in all of this. Pick ONE provider to start with.
# The recommended starting point is Gemini: the free tier is generous and
# getting a key takes about a minute.
#
#   1. copy this file:   cp .env.example .env
#   2. get a free key:   https://aistudio.google.com/api-keys
#   3. paste it below and you are done
# ---------------------------------------------------------------------------

# Which provider to use: gemini | groq | ollama
HIRELENS_LLM_PROVIDER=gemini

# ---- Option A: Google Gemini (recommended, free tier) ----------------------
# Key from https://aistudio.google.com/api-keys
HIRELENS_GEMINI_API_KEY=
# Google retires pinned model names and stops serving them to new keys, which
# shows up as a 404 rather than anything that says "retired". The `-latest`
# alias keeps working. Run `hirelens models` to list what your key can call.
HIRELENS_GEMINI_MODEL=gemini-flash-latest

# ---- Option B: Groq (free tier, very fast) --------------------------------
# Key from https://console.groq.com/keys
HIRELENS_GROQ_API_KEY=
HIRELENS_GROQ_MODEL=llama-3.3-70b-versatile

# ---- Option C: Ollama (fully local, no key, no internet) ------------------
# Install from https://ollama.com then: ollama pull qwen3:4b
HIRELENS_OLLAMA_HOST=http://localhost:11434
HIRELENS_OLLAMA_MODEL=qwen3:4b

# ---------------------------------------------------------------------------
# Embeddings. These run locally on CPU and never call an API, so there is
# nothing to pay for and nothing to configure unless you want a bigger model.
# ---------------------------------------------------------------------------
HIRELENS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Generation behaviour
# ---------------------------------------------------------------------------
# Temperature for extraction calls. Keep this near zero: we want determinism.
HIRELENS_EXTRACTION_TEMPERATURE=0.0
# Temperature for judging calls. Non-zero on purpose so self-consistency
# sampling actually explores. See docs/DESIGN.md section 4.
HIRELENS_JUDGE_TEMPERATURE=0.3
# How many times each requirement is judged before taking the median.
# Higher = more stable and more honest confidence bands, but slower and more
# API calls. 3 is a reasonable free-tier compromise.
HIRELENS_SELF_CONSISTENCY_K=3

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Free tiers enforce a per-minute request quota. Gemini's flash models currently
# allow 20 per minute. Requests are paced client-side to stay under it, because
# retrying into a rate limit eventually gives up and records "judging failed",
# which looks identical to "no evidence found" in the report. A candidate should
# never lose points to a quota.
#
# Set to 0 to disable pacing.
HIRELENS_REQUESTS_PER_MINUTE=15

# Concurrent in-flight requests. Keep this low on a free tier: a burst of
# parallel calls trips a per-minute quota in seconds.
HIRELENS_MAX_CONCURRENT_REQUESTS=2

# ---------------------------------------------------------------------------
# Caching. On by default. Identical prompts hit disk instead of the API, which
# makes iterating on prompts free and makes the eval harness reproducible.
# ---------------------------------------------------------------------------
HIRELENS_CACHE_ENABLED=true
HIRELENS_CACHE_DIR=.hirelens_cache

# ---------------------------------------------------------------------------
# Screening policy
# ---------------------------------------------------------------------------
# Strip names, emails, phones, addresses and institution names before anything
# reaches the model. On by default. This is a fairness control, not a privacy
# nicety: it removes the signal the bias audit is looking for.
HIRELENS_BLIND_MODE=true

# Fail the fairness audit if a counterfactual demographic swap moves the
# overall score by more than this many points.
HIRELENS_MAX_DEMOGRAPHIC_DRIFT=2.0

# ---------------------------------------------------------------------------
# Optional: GitHub enrichment. Works without a token at 60 requests/hour.
# A classic token with no scopes raises that to 5000/hour.
# ---------------------------------------------------------------------------
HIRELENS_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Logging: DEBUG | INFO | WARNING | ERROR
# ---------------------------------------------------------------------------
HIRELENS_LOG_LEVEL=INFO
