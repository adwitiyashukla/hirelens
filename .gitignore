# secrets
.env
*.pem
*.key

# hirelens runtime artefacts
.hirelens_cache/
evals/reports/*.json
evals/reports/*.html
evals/reports/*.png
!evals/reports/.gitkeep
uploads/
*.sqlite
*.db
# SQLite's write-ahead log and shared-memory files. They sit beside the database
# in WAL mode and are pure runtime state, but *.db does not match their names.
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# Scratch file used to pass a long commit message to `git commit -F`.
COMMIT_MSG.tmp

# Staging area for raw screen captures. Only the ones selected for the README
# are committed, under docs/screenshots/, so that the repository does not carry
# every discarded take.
/screenshots/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# node / frontend
node_modules/
web/dist/
web/.vite/
*.local

# editors and os
.vscode/
.idea/
.DS_Store
Thumbs.db
